<%- include('partials/header') %>

    <main>

        <h1>
            <%= category.name %>
        </h1>

        <h2>Projects in this Category</h2>
        <% if (user && user.role_name==='admin' ) { %>

            <a class="add-button" href="/edit-category/<%= category.category_id %>">
                Edit
            </a>
            <% } %>
                <ul>

                    <% projects.forEach(project=> { %>

                        <li>

                            <a href="/projects/<%= project.project_id %>">

                                <%= project.title %>

                            </a>

                        </li>

                        <% }) %>

                </ul>

    </main>

    <%- include('partials/footer') %>
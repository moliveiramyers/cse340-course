<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.project_date).toLocaleDateString() %>:
                            <%= project.title %>
                    </strong>

                    <span>
                        (<%= project.organization_name %>)
                    </span>

                    <p>
                        <%= project.description %>
                    </p>
                </li>
                <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.date).toLocaleDateString() %>: <a href="/projects/<%= project.project_id %>"><%= project.title %></a>
                            
                    </strong>

                    <span>
                        <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </span>

                    <p>
                        <%= project.description %>
                    </p>
                </li>
                <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <section>
            <h2>Description</h2>
            <p>
                <%= project.description %>
            </p>
        </section>

        <section>
            <h2>Details</h2>

            <p><strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString() %>
            </p>

            <p><strong>Location:</strong>
                <%= project.location %>
            </p>

        </section>

        <section>
            <h2>Organization</h2>

            <a href="/organizations/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </section>

    </main>
    <%- include('partials/footer') %>
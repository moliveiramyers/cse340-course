<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <section>
            <h2>Description</h2>
            <p>
                <%= project.description %>
            </p>
        </section>

        <section>
            <h2>Details</h2>

            <p><strong>Date:</strong>
                <%= project.date ? new Date(project.date).toLocaleDateString() : '' %>
            </p>

            <p><strong>Location:</strong>
                <%= project.location %>
            </p>

        </section>

        <section>
            <h2>Organization</h2>

            <a href="/organizations/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>

        </section>
        <section>

            <h2>Categories</h2>

            <div class="category-tags">

                <% project.categories.forEach(category=> { %>

                    <!-- CHANGED: category tag links to category details page -->
                    <a class="category-tag" href="/categories/<%= category.category_id %>">
                        <%= category.name %>
                    </a>

                    <% }) %>

            </div>
            <% if (user && user.role_name==='admin' ) { %>

                <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
                <p>
                    <a class="add-button" href="/edit-project/<%= project.project_id %>">
                        Edit Project
                    </a>
                </p>
                <% } %>

        </section>
    </main>
    <%- include('partials/footer') %>
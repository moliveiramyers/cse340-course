<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <a class="add-button" href="/new-category" class="add-button">
                + Add New Category
            </a>

            <% categories.forEach(category=> { %>

                <li>
                    <a href="/categories/<%= category.category_id %>">

                        <%= category.name %>

                    </a>

                </li>

                <% }) %>

        </ul>


    </main>

    <%- include('partials/footer') %>